<script>
 $(document).ready(function () {
    $('#DataTable').DataTable({
        processing: true,
        serverSide: true,
        ajax: {
            url: '{{ route("admin.article.datatable") }}',
            type: 'GET'
        },
        lengthMenu: [10, 25, 50, 100],
        pageLength: 10,
        ordering: false,

        columns: [
            { data: 'name', name: 'name' },
            { data: 'title',orderable: false,searchable: false},
            { data: 'long_description', name:'long_description' },
            { data: 'status', name: 'status' },
            { data: 'publishDate', name: 'publishDate' },

            // Removed duplicate status column

            {
                data: 'action',
                name: 'action',
                orderable: false,
                searchable: false
            }
        ],

        drawCallback: function () {
            $('[data-toggle="tooltip"]').tooltip();
        }
    });
});



    $('body').on('click', '.toggle-status', function () {
        var studentId = $(this).data('id');
        var button = $(this);

        $.ajax({
            url: '{{ route('admin.article.status') }}', 
            method: 'POST',
            data: {
                _token: '{{ csrf_token() }}',
                id: studentId
            },
            success: function (response) {
                if (response.success) {
                    let newClass = response.status == 1 ? 'bg-success' : 'bg-danger';
                    let newText = response.status == 1 ? 'Active' : 'Inactive';

                    button.removeClass('bg-success bg-danger').addClass(newClass).text(newText);
                }
            },
            error: function () {
                alert('Something went wrong.');
            }
        });
    });

  

</script>
